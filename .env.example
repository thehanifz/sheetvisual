# SheetViz Phase 1 local-development configuration.
# Copy this file to .env for local use. Never commit .env.
# All values below are local placeholders, not production credentials.

APP_ENV=local
APP_DATABASE_URL=postgresql://sheetviz:sheetviz@localhost:5432/sheetviz
APP_REDIS_URL=redis://localhost:6379/0
APP_LOG_LEVEL=INFO
